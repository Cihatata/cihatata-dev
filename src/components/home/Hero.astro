---
import { Image } from 'astro:assets';

import SocialLinks from '~/components/ui/SocialLinks.astro';
import avatar from '~/assets/avatar.png';
import { AUTHOR } from '~/config/site';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="animate-rise">
  <div class="flex items-center gap-5">
    <div class="avatar-ring shrink-0">
      <Image
        src={avatar}
        alt={t('hero.avatarAlt')}
        width={112}
        height={112}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
        class="size-[72px] rounded-full object-cover sm:size-[88px]"
      />
    </div>

    <h1 class="text-2xl font-semibold sm:text-3xl">{AUTHOR.name}</h1>
  </div>

  <p class="mt-6 text-base leading-relaxed text-fg-muted sm:text-lg">
    {t('hero.bio')}
  </p>

  <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
    <span class="text-sm text-fg-subtle">{t('hero.findMeOn')}</span>
    <SocialLinks />
  </div>
</section>

<style>
  /* A thin glass rim so the avatar reads as sitting under the same material. */
  .avatar-ring {
    position: relative;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    padding: 3px;
    background: linear-gradient(
      150deg,
      var(--glass-highlight),
      transparent 45%,
      var(--glass-ring)
    );
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 10px 30px -12px rgb(0 0 0 / 0.35);
  }

  .avatar-ring::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 1px solid var(--glass-border);
    pointer-events: none;
  }
</style>
