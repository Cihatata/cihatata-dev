---
import Icon from '~/components/ui/Icon.astro';
import { attributionLink, photoSrcSet, photoUrl, type UnsplashPhoto } from '~/lib/photos';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  photo: UnsplashPhoto;
  locale: Locale;
  /** Above-the-fold photos skip lazy loading. */
  eager?: boolean;
  sizes?: string;
  /** `natural` keeps the original crop; `square` gives a tidy teaser grid. */
  aspect?: 'natural' | 'square';
}

const {
  photo,
  locale,
  eager = false,
  sizes = '(min-width: 40rem) 22rem, 50vw',
  aspect = 'natural',
} = Astro.props;
const t = useTranslations(locale);

const alt = photo.altDescription ?? photo.description ?? t('photos.fallbackAlt');
const ratio = aspect === 'square' ? '1 / 1' : `${photo.width} / ${photo.height}`;
---

<a
  href={attributionLink(photo.link)}
  target="_blank"
  rel="noopener noreferrer"
  class="photo group relative block overflow-hidden rounded-2xl"
  style={`background-color: ${photo.color}`}
  aria-label={`${alt} — ${t('photos.viewOnUnsplash')}`}
>
  <img
    src={photoUrl(photo, 640)}
    srcset={photoSrcSet(photo, [320, 480, 640, 960])}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    style={`aspect-ratio: ${ratio}`}
    class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-glass)] group-hover:scale-[1.04]"
  />

  <span class="photo__veil" aria-hidden="true"></span>

  <span
    class="glass glass--pill photo__badge absolute right-3 bottom-3 flex items-center gap-1.5 px-2.5 py-1 text-[0.6875rem] font-medium"
  >
    <Icon name="external" size={11} />
    {t('photos.viewOnUnsplash')}
  </span>
</a>

<style>
  .photo {
    isolation: isolate;
    box-shadow: var(--glass-shadow);
  }

  .photo__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.4), transparent 45%);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-glass);
  }

  .photo__badge {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--duration-base) var(--ease-glass),
      transform var(--duration-base) var(--ease-glass);
  }

  .photo:hover .photo__veil,
  .photo:focus-visible .photo__veil,
  .photo:hover .photo__badge,
  .photo:focus-visible .photo__badge {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .photo__badge {
      opacity: 1;
      transform: none;
    }
  }
</style>
