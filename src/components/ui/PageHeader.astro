---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="animate-rise mb-10">
  {
    eyebrow && (
      <p class="mb-2 text-xs font-medium tracking-[0.14em] text-fg-subtle uppercase">{eyebrow}</p>
    )
  }
  <h1 class="text-3xl font-semibold sm:text-4xl">{title}</h1>
  {description && <p class="mt-3 max-w-prose text-fg-muted">{description}</p>}
  <slot />
</header>
