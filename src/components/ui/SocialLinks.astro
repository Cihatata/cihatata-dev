---
import Icon from './Icon.astro';
import { SOCIALS } from '~/config/site';

interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 18 } = Astro.props;
---

<ul class:list={['flex items-center gap-2', className]}>
  {
    SOCIALS.map((social) => (
      <li>
        <a
          href={social.href}
          target="_blank"
          rel="me noopener noreferrer"
          class="social-link grid size-9 place-items-center rounded-full text-fg-muted"
          aria-label={social.label}
          title={social.label}
        >
          <Icon name={social.id} size={size} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-link {
    position: relative;
    isolation: isolate;
    transition:
      color var(--duration-base) var(--ease-glass),
      transform var(--duration-fast) var(--ease-glass);
  }

  .social-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    border: 1px solid transparent;
    background-color: transparent;
    opacity: 0;
    transform: scale(0.75);
    transition:
      opacity var(--duration-base) var(--ease-glass),
      transform var(--duration-base) var(--ease-glass),
      background-color var(--duration-base) var(--ease-glass);
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--fg);
  }

  .social-link:hover::before,
  .social-link:focus-visible::before {
    opacity: 1;
    transform: scale(1);
    background-color: var(--glass-bg-strong);
    border-color: var(--glass-border);
    box-shadow:
      inset 0 1px 0 0 var(--glass-highlight),
      0 2px 10px -4px rgb(0 0 0 / 0.25);
  }

  .social-link:active {
    transform: scale(0.92);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .social-link:hover::before,
    .social-link:focus-visible::before {
      background-color: var(--glass-bg);
      -webkit-backdrop-filter: blur(12px) saturate(160%);
      backdrop-filter: blur(12px) saturate(160%);
    }
  }
</style>
