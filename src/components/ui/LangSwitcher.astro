---
import Icon from './Icon.astro';
import { LOCALE_LABELS, LOCALE_SHORT } from '~/i18n/ui';
import { localizePath, otherLocale, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
  /** Locale-independent path of the current page, e.g. `/contents`. */
  path: string;
  class?: string;
}

const { locale, path, class: className } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
---

<a
  href={localizePath(path, target)}
  hreflang={target}
  lang={target}
  rel="alternate"
  data-lang-switch
  data-locale={target}
  class:list={[
    'glass glass--pill glass--interactive flex h-9 items-center gap-1.5 px-3 text-fg-muted hover:text-fg',
    className,
  ]}
  aria-label={`${t('lang.switch')}: ${LOCALE_LABELS[target]}`}
  title={LOCALE_LABELS[target]}
>
  <Icon name="globe" size={15} />
  <span class="text-xs font-medium tracking-wide">{LOCALE_SHORT[target]}</span>
</a>

<script>
  const COOKIE = 'lang';
  const MAX_AGE = 60 * 60 * 24 * 365;

  function setLocaleCookie(locale: string) {
    const secure = location.protocol === 'https:' ? '; Secure' : '';
    document.cookie = `${COOKIE}=${locale}; Path=/; Max-Age=${MAX_AGE}; SameSite=Lax${secure}`;
  }

  const bind = () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((link) => {
      if (link.dataset.bound === 'true') return;
      link.dataset.bound = 'true';
      link.addEventListener('click', () => {
        const locale = link.dataset.locale;
        if (locale === 'en' || locale === 'tr') setLocaleCookie(locale);
      });
    });
  };

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
