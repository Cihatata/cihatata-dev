---
import { ICONS, type IconDefinition, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  /** Provide when the icon is the only content of its container. */
  label?: string;
}

const { name, size = 20, class: className, label } = Astro.props;
// Widened on purpose: the literal `as const` map only carries `filled` on the
// brand marks, so the union would not expose the property at all.
const icon: IconDefinition = ICONS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? undefined : 'currentColor'}
  stroke-width={icon.filled ? undefined : 1.75}
  stroke-linecap={icon.filled ? undefined : 'round'}
  stroke-linejoin={icon.filled ? undefined : 'round'}
  set:html={icon.body}
/>
