---
import GlassSurface from '~/components/glass/GlassSurface.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  message: string;
  title?: string;
  icon?: IconName;
}

const { message, title, icon = 'sparkle' } = Astro.props;
---

<GlassSurface class="px-6 py-12 text-center">
  <span
    class="mx-auto mb-4 grid size-11 place-items-center rounded-full border border-border text-fg-subtle"
  >
    <Icon name={icon} size={18} />
  </span>
  {title && <h2 class="text-lg font-semibold">{title}</h2>}
  <p class="mx-auto mt-1 max-w-sm text-sm text-fg-muted">{message}</p>
  <slot />
</GlassSurface>
