---
import GlassSurface from '~/components/glass/GlassSurface.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import Icon from '~/components/ui/Icon.astro';
import { thumbnailFor, type VideoEntry } from '~/data/videos';
import { formatDateShort, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  videos: VideoEntry[];
  locale: Locale;
}

const { videos, locale } = Astro.props;
const t = useTranslations(locale);
---

{
  videos.length === 0 ? (
    <EmptyState message={t('videos.empty')} icon="play" />
  ) : (
    <div class="grid gap-4 sm:grid-cols-2">
      {videos.map((video) => {
        const thumbnail = thumbnailFor(video);
        const copy = video[locale];

        return (
          <GlassSurface as="article" interactive sheen class="group relative overflow-hidden">
            {thumbnail && (
              <img
                src={thumbnail}
                alt=""
                loading="lazy"
                decoding="async"
                class="aspect-video w-full object-cover transition-transform duration-700 ease-[var(--ease-glass)] group-hover:scale-[1.03]"
              />
            )}

            <div class="p-5">
              <div class="flex items-center gap-2 text-xs text-fg-subtle">
                <time datetime={video.publishedAt}>
                  {formatDateShort(new Date(video.publishedAt), locale)}
                </time>
                {video.duration && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{video.duration}</span>
                  </>
                )}
              </div>

              <h3 class="mt-2 leading-snug font-semibold">
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="after:absolute after:inset-0"
                >
                  {copy.title}
                </a>
              </h3>

              <p class="mt-2 line-clamp-2 text-sm text-fg-muted">{copy.description}</p>

              <span class="mt-3 inline-flex items-center gap-1.5 text-sm text-accent">
                <Icon name="play" size={14} />
                {t('videos.watch')}
              </span>
            </div>
          </GlassSurface>
        );
      })}
    </div>
  )
}
