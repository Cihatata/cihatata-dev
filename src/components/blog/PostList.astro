---
import PostCard from './PostCard.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import type { Post } from '~/lib/blog';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  posts: Post[];
  locale: Locale;
  variant?: 'card' | 'row';
  /** Renders only the first N posts; omit to render everything. */
  limit?: number;
}

const { posts, locale, variant = 'card', limit } = Astro.props;
const t = useTranslations(locale);
const visible = limit ? posts.slice(0, limit) : posts;
---

{
  visible.length === 0 ? (
    <EmptyState message={t('blog.empty')} />
  ) : (
    <div class:list={[variant === 'card' ? 'grid gap-4 sm:grid-cols-2' : 'divide-y divide-border']}>
      {visible.map((post) => (
        <PostCard post={post} locale={locale} variant={variant} />
      ))}
    </div>
  )
}
