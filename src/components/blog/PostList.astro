---
import PostRow from './PostRow.astro';
import EmptyState from '~/components/ui/EmptyState.astro';
import type { Post } from '~/lib/blog';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  posts: Post[];
  locale: Locale;
  /** Renders only the first N posts; omit to render everything. */
  limit?: number;
}

const { posts, locale, limit } = Astro.props;
const t = useTranslations(locale);
const visible = limit ? posts.slice(0, limit) : posts;
---

{
  visible.length === 0 ? (
    <EmptyState message={t('blog.empty')} />
  ) : (
    <ul class="space-y-4 sm:space-y-2">
      {visible.map((post) => (
        <PostRow post={post} locale={locale} />
      ))}
    </ul>
  )
}
