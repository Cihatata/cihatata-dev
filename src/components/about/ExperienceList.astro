---
import { EXPERIENCE, type ExperienceEntry } from '~/data/experience';
import type { Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
  presentLabel: string;
}

const { locale, presentLabel } = Astro.props;

const monthFmt = new Intl.DateTimeFormat(locale === 'tr' ? 'tr-TR' : 'en-US', {
  month: 'short',
  year: 'numeric',
});

function parseMonth(value: string): Date {
  const [year, month] = value.split('-').map(Number);
  return new Date(year, month - 1, 1);
}

function formatRange(start: string, end: string | null): string {
  const from = monthFmt.format(parseMonth(start));
  const to = end ? monthFmt.format(parseMonth(end)) : presentLabel;
  return `${from} – ${to}`;
}

function primaryTitle(entry: ExperienceEntry): string {
  return entry.roles[0]?.title ?? entry.company;
}
---

<ol class="experience-list mt-6 space-y-8">
  {
    EXPERIENCE.map((entry) => (
      <li>
        <h3 class="text-base font-semibold leading-snug">
          {primaryTitle(entry)}
          <span class="font-normal text-fg-muted"> · {entry.company}</span>
        </h3>

        <p class="mt-1 text-sm text-fg-subtle">{formatRange(entry.start, entry.end)}</p>

        {entry.roles.length > 1 && (
          <ul class="mt-3 space-y-1.5 border-l border-border pl-3">
            {entry.roles.map((role) => (
              <li class="text-sm text-fg-muted">
                <span class="font-medium text-fg">{role.title}</span>
                <span class="text-fg-subtle"> · {formatRange(role.start, role.end)}</span>
              </li>
            ))}
          </ul>
        )}

        <p class="mt-3 text-sm leading-relaxed text-fg-muted">{entry[locale].summary}</p>
      </li>
    ))
  }
</ol>
