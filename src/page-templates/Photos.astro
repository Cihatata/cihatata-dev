---
import ContentsChrome from '~/components/contents/ContentsChrome.astro';
import PhotoGrid from '~/components/photos/PhotoGrid.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getPhotos } from '~/lib/photos';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const photos = getPhotos();
---

<BaseLayout
  title={`${t('contents.title')} · ${t('contents.photos')}`}
  description={t('contents.description')}
  path="/contents/photos"
  locale={locale}
  instantTransition
>
  <ContentsChrome locale={locale} active="photos" />

  <PhotoGrid photos={photos} locale={locale} layout="masonry" eagerCount={3} />
</BaseLayout>
