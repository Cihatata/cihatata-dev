---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';

import SocialLinks from '~/components/ui/SocialLinks.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import avatar from '~/assets/avatar.png';
import { AUTHOR } from '~/config/site';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const entry = await getEntry('about', locale);
if (!entry) return Astro.rewrite('/404');

const { Content } = await render(entry);

const schema = [
  {
    '@type': 'AboutPage',
    name: entry.data.title,
    description: entry.data.description,
    inLanguage: locale,
    mainEntity: { '@id': `${(Astro.site ?? new URL('https://cihatata.dev')).origin}/#person` },
  },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path="/about"
  locale={locale}
  type="profile"
  schema={schema}
>
  <div class="animate-rise">
    <div class="flex items-center gap-4">
      <Image
        src={avatar}
        alt={t('hero.avatarAlt')}
        width={72}
        height={72}
        densities={[1, 2]}
        loading="eager"
        class="size-14 rounded-full object-cover"
      />
      <div>
        <h1 class="text-3xl font-semibold sm:text-4xl">{entry.data.heading}</h1>
        <p class="mt-1 text-sm text-fg-subtle">
          {AUTHOR.jobTitle} · {AUTHOR.company} · {AUTHOR.location}
        </p>
      </div>
    </div>

    <div class="prose mt-8">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="text-sm text-fg-subtle">{t('hero.findMeOn')}</span>
      <SocialLinks />
    </div>
  </div>
</BaseLayout>
