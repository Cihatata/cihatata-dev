---
import ContentTabs from '~/components/contents/ContentTabs.astro';
import PostList from '~/components/blog/PostList.astro';
import TagPill from '~/components/ui/TagPill.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { collectTags, filterByTag, getPosts } from '~/lib/blog';
import { localizePath, useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
  tag: string;
}

const { locale, tag } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale);
const tags = collectTags(posts);
const current = tags.find((entry) => entry.slug === tag);

if (!current) return Astro.rewrite('/404');

const filtered = filterByTag(posts, tag);
const title = t('blog.tagged', { tag: current.label });
---

<BaseLayout
  title={title}
  description={t('contents.blogsDescription')}
  path={`/contents/tag/${tag}`}
  locale={locale}
>
  <PageHeader eyebrow={t('blog.tags')} title={title} />

  <ContentTabs locale={locale} active="blogs" />

  <div class="mb-8 flex flex-wrap gap-2">
    {
      tags.map((entry) => (
        <TagPill
          label={entry.label}
          count={entry.count}
          href={localizePath(`/contents/tag/${entry.slug}`, locale)}
          active={entry.slug === tag}
        />
      ))
    }
  </div>

  <PostList posts={filtered} locale={locale} variant="row" />
</BaseLayout>
