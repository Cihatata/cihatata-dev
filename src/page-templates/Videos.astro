---
import ContentTabs from '~/components/contents/ContentTabs.astro';
import VideoList from '~/components/videos/VideoList.astro';
import PageHeader from '~/components/ui/PageHeader.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getVideos } from '~/data/videos';
import { useTranslations, type Locale } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const videos = getVideos();
---

<BaseLayout
  title={`${t('contents.title')} · ${t('contents.videos')}`}
  description={t('contents.description')}
  path="/contents/videos"
  locale={locale}
>
  <PageHeader title={t('contents.title')} description={t('contents.description')} />

  <ContentTabs locale={locale} active="videos" />

  <VideoList videos={videos} locale={locale} />
</BaseLayout>
